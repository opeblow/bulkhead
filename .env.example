# ─────────────────────────────────────────────────────────────
# Bulkhead configuration. Copy to .env and fill in what you need.
# With nothing set, Bulkhead runs fully offline: a high-fidelity
# Airwallex sandbox simulator plus a deterministic advisor.
# ─────────────────────────────────────────────────────────────

# Airwallex mode: "simulator" (default) or "sandbox" (real Airwallex sandbox REST API).
AIRWALLEX_MODE=simulator
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Webhook secret shown when you create the subscription in the sandbox web app.
AIRWALLEX_WEBHOOK_SECRET=

# Existing connected accounts (acct_...) to reuse in sandbox mode. Comma-separated, A,B,C order.
# Leave empty to have Bulkhead create and activate three employer accounts.
AIRWALLEX_EMPLOYER_ACCOUNT_IDS=

# Claude advisor. When unset, Bulkhead uses its deterministic advisor (same options, rule-based ranking).
ANTHROPIC_API_KEY=
BULKHEAD_MODEL=claude-opus-5-5

# Server
PORT=8787
HOST=127.0.0.1
BULKHEAD_DATA_DIR=./data
# Shared secret operators send as `x-bulkhead-operator` for mutating console calls. Empty = local dev only.
BULKHEAD_OPERATOR_TOKEN=
LOG_LEVEL=info
